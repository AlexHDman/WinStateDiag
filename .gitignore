# Rust build
/target/

# Distribution binaries (published as GitHub Release assets, not in git)
/dist/*
!/dist/.gitkeep

# Diagnostic reports / runtime state (real machine data — never commit)
/Reports/
/reports/
**/Reports/
*.zip
WinStateDiag.lang
startup_graphics.log*
ssd_benchmark_history.log
WinStateDiag_Log_*.txt
*.candidate
*.part

# Internal engineering material
/docs/AUDIT/
/legacy-tests/

# Assistant / local working artifacts
/Claude outputs/

# Temporary / backup files
*.log
*.tmp
*.bak
*.before-*
*~
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# v1.0: QA renders are regenerated by the release gate (QA artifacts, not
# runtime dependencies; ~6 MB each) — kept locally, not in git.
/docs/visual/*.png
/docs/visual/*.json
# Live-validation checklists that name client machines stay local.
/docs/validation/GALINA_HOME_*.md
# Third-party binaries come from the audited fetch script (nuget.org);
# only their licence / notice files are tracked.
/third_party/*/lib/
/third_party/*/packages/
/third_party/*.jpg
# Generated previews / caches
/assets/expc-header-logo-full.png
__pycache__/

# Release gate evidence (logs, manifests with producer commit, probe
# outputs, superseded EXE backups) - local, never committed.
/release-evidence/
